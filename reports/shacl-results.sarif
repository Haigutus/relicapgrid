          "properties": {
            "count": 9,
            "key": "TapChanger.neutralU",
            "sampleIDs": [
              "920f9cbd-0f0e-bf5d-083e-dbf16aad8b0f",
              "a11d2b46-cf3a-449d-e89e-e96085aef0cf",
              "1d61cd3e-d131-8bbb-f4a2-8a711c95dc1e",
              "493f9319-387f-2683-2bcd-a1940360f0e2",
              "1a33a841-7d4e-0485-bd31-45caf3cce221",
              "601760f8-722f-2c5d-60a6-246344aa08da"
            ],
            "sampleValues": [
              "135",
              "50"
            ],
            "violationType": "triplets:lexicalForm",
            "sourceShape": "http://iec.ch/TC57/ns/CIM/CoreEquipment-EU/Constraints#TapChanger.neutralU-datatype",
            "schemaDescription": "Voltage at which the winding operates at the neutral tap setting. It is the voltage at the terminal of the PowerTransformerEnd associated with the tap changer when all tap changers on the transformer are at their neutralStep position.  Normally neutralU of the tap changer is the same as ratedU of the PowerTransformerEnd, but it can differ in special cases such as when the tapping mechanism is separate from the winding more common on lower voltage transformers.\nThis attribute is not relevant for PhaseTapChangerAsymmetrical, PhaseTapChangerSymmetrical and PhaseTapChangerLinear. ",
            "schemaMultiplicity": "1..1",
            "classDescription": "A tap changer that changes the voltage ratio impacting the voltage magnitude but not the phase angle across the transformer.\n\nAngle sign convention (general): Positive value indicates a positive phase shift from the winding where the tap is located to the other winding (for a two-winding transformer)."
          }
        },
